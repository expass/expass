{
  "name": "@expass/root",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "description": "Password encoder library, with salt + pepper and anti-paralization protection",
  "scripts": {
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "test": "npx lerna run test",
    "clean": "npx lerna run clean",
    "build": "npx lerna run build",
    "lerna": "npx lerna",
    "docs:start": "npm --workspace @expass/docs run start",
    "docs:build": "npm --workspace @expass/docs run build",
    "docs:serve": "npm --workspace @expass/docs run serve",
    "docs:deploy": "npm --workspace @expass/docs run deploy"
  },
  "keywords": [
    "password",
    "hash",
    "script"
  ],
  "author": "Exos <oscar@gentisoft.com>",
  "homepage": "https://github.com/expass/expass",
  "repository": {
    "type": "git",
    "url": "https://github.com/expass/expass.git"
  },
  "license": "GPL-2.0",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jest": "^30.5.2",
    "lerna": "^10.1.1",
    "npm-check-updates": "^23.1.1",
    "rimraf": "^6.1.4",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "overrides": {
    "nx": {
      "undici": "^7.30.2"
    },
    "@docusaurus/core": {
      "tinypool": "^2.2.0"
    },
    "serialize-javascript": "^7.1.4",
    "sockjs": {
      "uuid": "^11.1.1"
    },
    "mermaid": {
      "katex": "^0.18.2"
    },
    "glob": "^14.0.4",
    "minimatch": "^11.0.5",
    "serve-handler": {
      "minimatch": "3.1.5"
    }
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0"
  }
}
