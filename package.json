{
  "name": "@expass/root",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "description": "Password encoder library, with salt + pepper and anti-paralization protection",
  "scripts": {
    "test": "npx lerna run test",
    "clean": "npx lerna run clean",
    "build": "npx lerna run build",
    "lerna": "npx lerna",
    "docs:start": "npm --workspace @expass/docs run start",
    "docs:build": "npm --workspace @expass/docs run build",
    "docs:serve": "npm --workspace @expass/docs run serve",
    "docs:deploy": "npm --workspace @expass/docs run deploy"
  },
  "keywords": [
    "password",
    "hash",
    "script"
  ],
  "author": "Exos <oscar@gentisoft.com>",
  "homepage": "https://github.com/expass/expass",
  "repository": {
    "type": "git",
    "url": "https://github.com/expass/expass.git"
  },
  "license": "GPL-2.0",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.30",
    "jest": "^30.3.0",
    "lerna": "^9.0.7",
    "npm-check-updates": "^19.6.3",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0"
  }
}
